{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "全国中古ショップ公開DB",
  "description": "自動更新で生成するUTF-8 JSON配列。構造を変える場合はSPECIFICATION.mdも更新する。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "chain",
      "chains",
      "brands",
      "categories",
      "subCategories",
      "lat",
      "lng",
      "address",
      "hours",
      "sourceIds",
      "assortmentStatus",
      "assortmentSources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "chain": {
        "type": "string",
        "enum": [
          "hardoff",
          "hobbyoff",
          "offhouse",
          "bookoff",
          "surugaya",
          "geo",
          "furuichi",
          "otakarasouko",
          "mandai",
          "mangasouko",
          "otakara_market",
          "kanteidan",
          "animate",
          "lashinbang",
          "melonbooks",
          "mandarake",
          "iosys",
          "janpara",
          "pc_koubou",
          "inverse",
          "craft_chain",
          "yellowsubmarine",
          "popondetta"
        ]
      },
      "chains": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "hardoff",
            "hobbyoff",
            "offhouse",
            "bookoff",
            "surugaya",
            "geo",
            "furuichi",
            "otakarasouko",
            "mandai",
            "mangasouko",
            "otakara_market",
            "kanteidan",
            "animate",
            "lashinbang",
            "melonbooks",
            "mandarake",
            "iosys",
            "janpara",
            "pc_koubou",
            "inverse",
            "craft_chain",
            "yellowsubmarine",
            "popondetta"
          ]
        },
        "minItems": 1
      },
      "brands": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "hardoff",
            "bookoff",
            "bookoff_plus",
            "bookoff_sb",
            "offhouse",
            "modeoff",
            "garageoff",
            "liquoroff",
            "hobbyoff",
            "surugaya",
            "lashinbang",
            "mandarake",
            "melonbooks",
            "animate",
            "geo",
            "furuichi",
            "otakarasouko",
            "mandai",
            "mangasouko",
            "kanteidan",
            "geo_mobile",
            "furuiti",
            "torekapark",
            "preyz",
            "ecotool",
            "ojamakan",
            "medio",
            "mandaishoten",
            "iosys",
            "janpara",
            "pc_koubou",
            "inverse",
            "goodwill",
            "yuzawaya",
            "tokai",
            "okadaya",
            "pandorahouse",
            "yellowsubmarine",
            "popondetta",
            "otakara_market"
          ]
        }
      },
      "categories": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "retro_game",
            "tcg",
            "figure_hobby",
            "pc_junk",
            "audio_inst",
            "book_media",
            "apparel_life",
            "craft"
          ]
        }
      },
      "subCategories": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "sub_retro_game",
            "sub_modern_game",
            "sub_tcg_card",
            "sub_board_game",
            "sub_figure",
            "sub_plamo",
            "sub_minicar_rail",
            "sub_retro_toy",
            "sub_pc_junk",
            "sub_smartphone",
            "sub_camera",
            "sub_tool_diy",
            "sub_home_appliance",
            "sub_audio",
            "sub_instrument",
            "sub_vinyl_record",
            "sub_comic_book",
            "sub_doujin",
            "sub_anime_goods",
            "sub_otome_goods",
            "sub_cd_dvd",
            "sub_apparel",
            "sub_luxury_brand",
            "sub_outdoor_sport",
            "sub_car_bike",
            "sub_liquor",
            "sub_furniture_zakka",
            "sub_craft_fabric",
            "sub_craft_yarn",
            "sub_craft_parts"
          ]
        }
      },
      "lat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "lng": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "address": {
        "type": "string"
      },
      "hours": {
        "type": "string"
      },
      "sourceIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "subBrand": {
        "type": "string"
      },
      "verified": {
        "type": "boolean"
      },
      "isCustom": {
        "type": "boolean"
      },
      "assortmentStatus": {
        "type": "string",
        "enum": [
          "confirmed",
          "partial",
          "unverified",
          "user_edited"
        ]
      },
      "assortmentSources": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "checkedAt",
            "labels",
            "name",
            "chain",
            "categories",
            "subCategories"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "checkedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "chain": {
              "type": "string",
              "enum": [
                "hardoff",
                "hobbyoff",
                "offhouse",
                "bookoff",
                "surugaya",
                "anime_shop",
                "general_game",
                "kanteidan",
                "iosys",
                "janpara",
                "pc_koubou",
                "inverse",
                "craft_chain"
              ]
            },
            "categories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "retro_game",
                  "tcg",
                  "figure_hobby",
                  "pc_junk",
                  "audio_inst",
                  "book_media",
                  "apparel_life",
                  "craft"
                ]
              }
            },
            "subCategories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "sub_retro_game",
                  "sub_modern_game",
                  "sub_tcg_card",
                  "sub_board_game",
                  "sub_figure",
                  "sub_plamo",
                  "sub_minicar_rail",
                  "sub_retro_toy",
                  "sub_pc_junk",
                  "sub_smartphone",
                  "sub_camera",
                  "sub_tool_diy",
                  "sub_home_appliance",
                  "sub_audio",
                  "sub_instrument",
                  "sub_vinyl_record",
                  "sub_comic_book",
                  "sub_doujin",
                  "sub_anime_goods",
                  "sub_otome_goods",
                  "sub_cd_dvd",
                  "sub_apparel",
                  "sub_luxury_brand",
                  "sub_outdoor_sport",
                  "sub_car_bike",
                  "sub_liquor",
                  "sub_furniture_zakka",
                  "sub_craft_fabric",
                  "sub_craft_yarn",
                  "sub_craft_parts"
                ]
              }
            }
          }
        }
      }
    }
  }
}
