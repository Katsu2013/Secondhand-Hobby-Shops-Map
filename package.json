{
  "name": "reuse-shop-pilgrimage-map",
  "version": "1.0.0",
  "private": true,
  "description": "Googleマップベースで全国のハードオフ・ホビーオフ・駿河屋等の中古ショップを検索なしで巡回・所要時間確認できるReact+TypeScriptウェブアプリ",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 8080",
    "docs": "typedoc",
    "update-data": "python scripts/update_all_official_data.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typedoc": "^0.26.11",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
